# Optional: merge a self-hosted job aggregator into the feed.
# The backend connection (sidecar URL and token) is set in the app's
# Settings > Connection, not here, so nothing secret is compiled in.
#
# Copy to .env.local (gitignored) and adjust before `npm run build`.

# legacy (the tailor sidecar) | ever-jobs | both
VITE_FEED_PROVIDER=legacy

VITE_EVER_JOBS_BASE_URL=http://localhost:3001/api
VITE_EVER_JOBS_SITES=remoteok,jobicy,arbeitnow,weworkremotely
VITE_EVER_JOBS_RESULTS_WANTED=50
VITE_EVER_JOBS_COUNTRY=USA
VITE_EVER_JOBS_SEARCH_TERM=
VITE_EVER_JOBS_LOCATION=
VITE_EVER_JOBS_API_KEY=
VITE_EVER_JOBS_TOKEN=
